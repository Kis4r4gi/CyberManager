<Window x:Class="CyberManager.Client.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración del equipo" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Border Style="{StaticResource Card}" Margin="24" Padding="28">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="C" FontSize="24" FontWeight="Bold" Foreground="#04131B"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Configurar esta estación" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="CyberManager · pantalla de equipo" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Dirección del servidor" Style="{StaticResource Label}" Margin="0,20,0,4" />
            <TextBox x:Name="ServerUrlBox" ToolTip="Ejemplo: http://192.168.1.10:5080" />

            <TextBlock Text="Número de equipo (StationId)" Style="{StaticResource Label}" Margin="0,14,0,4" />
            <TextBox x:Name="StationIdBox" ToolTip="Número que aparece en Administración › Equipos" />

            <TextBlock Text="Token del equipo" Style="{StaticResource Label}" Margin="0,14,0,4" />
            <TextBox x:Name="TokenBox" FontFamily="Consolas" />

            <TextBlock Text="Idioma de la estación" Style="{StaticResource Label}" Margin="0,14,0,4" />
            <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed">
                <ComboBoxItem Content="Español" Tag="es" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>

            <Border Background="#12233A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,16,0,0">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                           Text="El número de equipo y el token se copian desde la consola de administración, en Equipos › Token. El token es único para cada PC." />
            </Border>

            <TextBlock x:Name="StatusText" Text="" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" />

            <Grid Margin="0,22,0,0">
                <Button x:Name="TestButton" Content="Probar conexión" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Click="Test_Click"
                        ToolTip="Comprueba la conexión con el servidor." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Click="Cancel_Click" ToolTip="Cierra sin guardar cambios." />
                    <Button Content="Guardar y continuar" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" ToolTip="Guarda la configuración y abre el equipo." />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>

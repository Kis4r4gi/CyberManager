<Window x:Class="CyberManager.Client.SessionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberManager - Sesión"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowActivated="False">

    <Grid>
        <Border Background="#F20F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="16,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StationText" Text="PC-01" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="CustomerText" Text="Sesión activa" Style="{StaticResource Muted}" />
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,2,16,2" />

                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeLabel" Text="TIEMPO RESTANTE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="TimeText" Text="00:00" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="WarningText" Text="¡Tiempo agotado!" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="CONSUMO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="AmountText" Text="$ 0,00" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="AmountBsText" Text="Bs 0,00" Style="{StaticResource Muted}" />
                </StackPanel>

                <Button Content="Pedir productos" Style="{StaticResource PrimaryButton}"
                        Padding="14,9" Click="Order_Click"
                        ToolTip="Abre el pedido de productos." />
                <Button x:Name="AccountButton" Content="Mi cuenta" Style="{StaticResource GhostButton}"
                        Padding="12,9" Margin="8,0,0,0" Click="Account_Click"
                        ToolTip="Muestra el consumo de la sesión." />
            </StackPanel>
        </Border>

        <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource Card}" Width="320" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Resumen de la sesión" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Tipo" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="AccountTypeText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Inicio" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="AccountStartedText" Text="—" HorizontalAlignment="Right" />
                    </Grid>

                    <Separator />

                    <Grid Margin="0,6,0,4">
                        <TextBlock Text="Tiempo" Style="{StaticResource Muted}" />
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="AccountTimeUsdText" Text="$ 0,00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccountTimeBsText" Text="Bs 0,00" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,4">
                        <TextBlock Text="Consumos" Style="{StaticResource Muted}" />
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="AccountConsumptionUsdText" Text="$ 0,00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccountConsumptionBsText" Text="Bs 0,00" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>

                    <Separator />

                    <Grid Margin="0,6,0,4">
                        <TextBlock Text="Total" FontWeight="SemiBold" FontSize="14" />
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="AccountTotalUsdText" Text="$ 0,00" HorizontalAlignment="Right"
                                       FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="AccountTotalBsText" Text="Bs 0,00" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="AccountRateText" Text="1 USD = — Bs" Style="{StaticResource Muted}"
                               Margin="0,10,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

<Window x:Class="CyberManager.Client.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CyberManager.Client"
        Title="CyberManager - Equipo bloqueado"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Background="#070B14"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.18" GradientOrigin="0.5,0.18" RadiusX="1.05" RadiusY="1.05">
                <GradientStop Color="#112843" Offset="0" />
                <GradientStop Color="#070B14" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Video promocional sincronizado ================= -->
        <MediaElement x:Name="PromoVideo" Grid.RowSpan="3" Stretch="UniformToFill"
                     Visibility="Collapsed" IsHitTestVisible="False"
                     LoadedBehavior="Manual" UnloadedBehavior="Manual" Volume="0"
                     MediaEnded="PromoVideo_MediaEnded" MediaFailed="PromoVideo_MediaFailed" />

        <!-- ================= Fondo sincronizado ================= -->
        <Image x:Name="WallpaperImage" Grid.RowSpan="3" Stretch="UniformToFill"
               Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

        <!-- Velo muy suave: el fondo se ve vivo y el texto se apoya en su contorno. -->
        <Border Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00070B14" Offset="0" />
                    <GradientStop Color="#1F070B14" Offset="0.45" />
                    <GradientStop Color="#66070B14" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ================= Encabezado ================= -->
        <Grid Grid.Row="0" Margin="44,30,44,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="C" FontSize="26" FontWeight="Bold" Foreground="#04131B"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <local:OutlinedTextBlock x:Name="BusinessNameText" Text="CyberManager" FontSize="19" FontWeight="Bold"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           Fill="{StaticResource TextBrush}" Stroke="#D9000000" StrokeThickness="3" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <local:OutlinedTextBlock x:Name="StationText" Text="PC-01" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Right" Fill="{StaticResource AccentBrush}"
                           Stroke="#D9000000" StrokeThickness="3" />
                <local:OutlinedTextBlock x:Name="ZoneText" Text="Zona estándar" FontSize="12"
                           HorizontalAlignment="Right" Fill="{StaticResource MutedBrush}"
                           Stroke="#D9000000" StrokeThickness="2" />
            </StackPanel>
        </Grid>

        <!-- ================= Centro ================= -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="104" Height="104" CornerRadius="30" Background="#CC16233A"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <local:OutlinedTextBlock x:Name="TitleText" Text="EQUIPO BLOQUEADO" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,30,0,0" Fill="{StaticResource AccentBrush}"
                       Stroke="#D9000000" StrokeThickness="3" />
            <local:OutlinedTextBlock x:Name="MessageText" Text="Solicite al cajero para iniciar su sesión."
                       FontSize="15" Fill="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                       Stroke="#D9000000" StrokeThickness="2.5" />

            <StackPanel x:Name="LoginPanel" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button x:Name="LoginButton" Content="Iniciar sesión" Style="{StaticResource PrimaryButton}"
                        Padding="26,12" FontSize="15" Click="Login_Click"
                        ToolTip="Inicie sesión con su cuenta prepago o como administrador." />

                <Popup x:Name="LoginPopup" PlacementTarget="{Binding ElementName=LoginButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource Card}" Width="310" Margin="0,8,0,0"
                            PreviewKeyDown="Popup_PreviewKeyDown">
                        <StackPanel>
                            <TextBlock Text="Iniciar sesión" Style="{StaticResource H2}" Margin="0,0,0,4" />
                            <TextBlock Text="Elija el tipo de cuenta." Style="{StaticResource Muted}"
                                       Margin="0,0,0,14" />

                            <Button Content="Cuenta prepago" Style="{StaticResource PrimaryButton}"
                                    HorizontalContentAlignment="Left" Padding="16,11" Click="PrepaidLogin_Click"
                                    ToolTip="Cree una cuenta o use sus minutos prepago." />
                            <TextBlock Text="Cree su cuenta, compre tiempo y juegue sin pasar por caja."
                                       Style="{StaticResource Muted}" Margin="2,6,2,14" TextWrapping="Wrap" />

                            <Button Content="Administrador" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Left" Padding="16,11" Click="AdminLogin_Click"
                                    ToolTip="Abre la configuración del cliente con una cuenta de administrador." />
                            <TextBlock Text="Acceso a la configuración del equipo enlazada al servidor."
                                       Style="{StaticResource Muted}" Margin="2,6,2,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </StackPanel>

        <!-- ================= Pie ================= -->
        <Border Grid.Row="2" Margin="44,0,44,30" Padding="20,15" Background="#590F172A"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <local:OutlinedTextBlock x:Name="FooterText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Fill="{StaticResource MutedBrush}"
                           Stroke="#D9000000" StrokeThickness="2" />

                <local:OutlinedTextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Fill="{StaticResource MutedBrush}"
                           Stroke="#D9000000" StrokeThickness="2" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="CyberManager.Admin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberManager · Iniciar sesión" Width="980" Height="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Marca ================= -->
        <Border Grid.Column="0" CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B2E4A" Offset="0" />
                    <GradientStop Color="#07101F" Offset="0.62" />
                    <GradientStop Color="#070B14" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="48">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="C" FontSize="32" FontWeight="Bold" Foreground="#04131B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CyberManager" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text="Gestión integral de cybercafé" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Controle cada equipo,&#x0a;cada minuto y cada bolívar."
                               FontSize="34" FontWeight="Bold" Margin="0,42,0,0" TextWrapping="Wrap"
                               LineHeight="44" />
                    <TextBlock Text="Sesiones prepago y postpago, caja en bolívares y dólares, inventario, facturación venezolana y reportes en tiempo real."
                               FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"
                               TextWrapping="Wrap" MaxWidth="420" LineHeight="22" />

                    <StackPanel Orientation="Horizontal" Margin="0,36,0,0">
                        <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="MONEDA BASE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="USD $ / Bs" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="IMPUESTOS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="IVA 16% · IGTF 3%" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="CyberManager · Venezuela" VerticalAlignment="Bottom"
                           Style="{StaticResource Muted}" FontSize="11" />
            </Grid>
        </Border>

        <!-- ================= Formulario ================= -->
        <Grid Grid.Column="1" Margin="48,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Iniciar sesión" Style="{StaticResource H1}" />
                <TextBlock Text="Ingrese sus credenciales para abrir la consola."
                           Style="{StaticResource Muted}" Margin="0,6,0,26" />

                <TextBlock Text="Servidor" Style="{StaticResource Label}" />
                <TextBox x:Name="ServerUrlBox" ToolTip="Ejemplo: http://192.168.1.10:5080" />

                <TextBlock Text="Usuario" Style="{StaticResource Label}" Margin="0,16,0,4" />
                <TextBox x:Name="UsernameBox" />

                <TextBlock Text="Contraseña" Style="{StaticResource Label}" Margin="0,16,0,4" />
                <PasswordBox x:Name="PasswordBox" KeyDown="Password_KeyDown" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,14,0,0" />

                <Button x:Name="LoginButton" Content="Entrar a la consola" Style="{StaticResource PrimaryButton}"
                        Padding="14,12" FontSize="14" Margin="0,24,0,0" Click="Login_Click" IsDefault="True"
                        ToolTip="Inicia sesión en la consola." />

                <Border Background="#12233A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,22,0,0">
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Acceso inicial: usuario admin y contraseña admin123. Cambie la contraseña en Configuración › Usuarios." />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

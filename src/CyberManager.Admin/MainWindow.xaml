<Window x:Class="CyberManager.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberManager · Administración" Width="1480" Height="900"
        MinWidth="1080" MinHeight="620" WindowStartupLocation="Manual"
        WindowState="Maximized" ResizeMode="CanResize" Background="{StaticResource BgBrush}">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Barra superior ================= -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Grid Width="34" Height="34">
                        <Border x:Name="LogoFallback" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="C" FontSize="20" FontWeight="Bold" Foreground="#04131B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="LogoFrame" CornerRadius="10" Background="Transparent"
                                ClipToBounds="True" Visibility="Collapsed">
                            <Image x:Name="LogoImage" Stretch="Uniform" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="BusinessNameText" Text="CyberManager" FontSize="16" FontWeight="Bold"
                               Margin="11,0,0,0" VerticalAlignment="Center" MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Consola de administración" />
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="12,6" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TASA DEL DÍA" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RateText" Text="1 USD = — Bs" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" Text="Usuario" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock x:Name="RoleText" Text="Administrador" Style="{StaticResource Muted}"
                                   FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Cuerpo ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" MinWidth="170" MaxWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="322" MinWidth="220" MaxWidth="520" x:Name="LogColumn" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="10,14,10,0">
                        <StackPanel x:Name="NavPanel">
                            <TextBlock x:Name="OperationLabel" Text="OPERACIÓN" Style="{StaticResource Label}" Margin="12,4,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="dashboard" Click="Nav_Click"
                                    ToolTip="Abre el tablero de equipos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Tablero de equipos" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="pos" Click="Nav_Click"
                                    ToolTip="Abre el punto de venta.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Punto de venta" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="cash" Click="Nav_Click"
                                    ToolTip="Abre la caja del turno.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Caja del turno" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="tickets" Click="Nav_Click"
                                    ToolTip="Busca tickets antiguos por número, cliente o producto y permite reimprimirlos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Buscar tickets" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="CatalogLabel" Text="CATÁLOGO" Style="{StaticResource Label}" Margin="12,16,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="products" Click="Nav_Click"
                                    ToolTip="Gestiona productos y tarifas.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Productos y tarifas" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="inventory" Click="Nav_Click"
                                    ToolTip="Consulta las existencias y los movimientos del inventario.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Inventario" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="purchases" Click="Nav_Click"
                                    ToolTip="Gestiona compras y proveedores.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Compras y proveedores" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="stations" Click="Nav_Click"
                                    ToolTip="Administra equipos y tokens.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Equipos y tokens" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="PeopleLabel" Text="PERSONAS" Style="{StaticResource Label}" Margin="12,16,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="customers" Click="Nav_Click"
                                    ToolTip="Gestiona clientes y saldos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Clientes y saldos" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="reservations" Click="Nav_Click"
                                    ToolTip="Gestiona las reservas de equipos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Reservas" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="SystemLabel" Text="SISTEMA" Style="{StaticResource Label}" Margin="12,16,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="media" Click="Nav_Click"
                                    ToolTip="Fondos y videos promocionales que se alternan en los equipos bloqueados.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Fondos y videos" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="reports" Click="Nav_Click"
                                    ToolTip="Consulta los reportes del negocio.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Reportes" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="troubleshoot" Click="Nav_Click"
                                    ToolTip="Diagnostica equipos, versiones y registros con IA en la nube.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Solucionador" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="settings" Click="Nav_Click"
                                    ToolTip="Abre la configuración del sistema.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Configuración" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="14,10,14,14">
                        <Button x:Name="SessionButton" Click="SessionMenu_Click"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,0,0,10"
                                ToolTip="Cambiar de usuario o cerrar la sesión actual.">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SessionNameText" Text="Sesión" FontWeight="SemiBold"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SessionRoleText" Text="Administrador"
                                               Style="{StaticResource Muted}" FontSize="9.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
                            </Grid>
                        </Button>
                        <Separator />
                        <TextBlock x:Name="VersionText" Text="CyberManager 1.0" Style="{StaticResource Muted}" FontSize="10" />
                        <TextBlock x:Name="ConnectionText" Text="Conectando..." Style="{StaticResource Muted}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <ContentControl x:Name="ContentHost" Margin="18" />
            </Grid>

            <!-- ================= Notas y registro de terminales ================= -->
            <Border x:Name="LogHost" Grid.Column="4" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="NotesRow" Height="3*" MinHeight="190" />
                        <RowDefinition x:Name="LogSplitRow" Height="4" />
                        <RowDefinition x:Name="LogRow" Height="2*" MinHeight="150" />
                    </Grid.RowDefinitions>

                    <!-- Registro de terminales -->
                    <Grid x:Name="LogSection" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="14,14,12,8" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="REGISTRO" Style="{StaticResource Label}" Margin="0" />
                                <TextBlock Text="Actividad de los terminales" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Abrir" Style="{StaticResource GhostButton}"
                                    FontSize="11" Padding="10,4" VerticalAlignment="Top"
                                    Click="OpenLogInNotepad_Click" ToolTip="Abre el registro completo en el Bloc de notas." />
                        </DockPanel>

                        <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LogPanel" Margin="12,0,10,8" />
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                            <Grid>
                                <TextBlock x:Name="LogCountText" Text="0 eventos" Style="{StaticResource Muted}" FontSize="10" />
                                <TextBlock Text="● En vivo" FontSize="10" Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </Grid>

                    <GridSplitter x:Name="LogSectionSplitter" Grid.Row="1" Height="4"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="{StaticResource BorderBrush}"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False" Cursor="SizeNS"
                                  ToolTip="Arrastre para ajustar la altura del registro y las notas" />

                    <!-- Notas visibles para todos los usuarios -->
                    <Grid x:Name="NotesSection" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="14,12,12,8" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="NOTAS" Style="{StaticResource Label}" Margin="0" />
                                <TextBlock Text="Visibles para todos los usuarios" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer x:Name="NotesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NotesPanel" Margin="12,0,10,8" />
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="NoteInput" MinHeight="52" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Escriba una nota breve para compartirla con todos los usuarios." />
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <TextBlock x:Name="NoteStatusText" Style="{StaticResource Muted}" FontSize="10"
                                               VerticalAlignment="Center" />
                                    <Button Content="Publicar nota" Style="{StaticResource PrimaryButton}"
                                            FontSize="11" Padding="10,4" HorizontalAlignment="Right"
                                            Click="PublishNote_Click" ToolTip="Publica la nota para todos los usuarios." />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE"
                          ToolTip="Arrastre para ajustar el ancho del menú lateral" />
            <GridSplitter x:Name="LogSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE"
                          ToolTip="Arrastre para ajustar el ancho del panel derecho" />
        </Grid>
    </Grid>
    </Border>
</Window>

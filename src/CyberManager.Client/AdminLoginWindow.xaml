<Window x:Class="CyberManager.Client.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso de administrador" Width="460" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PurpleBrush}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Acceso de administrador" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Configure este equipo desde el servidor." Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Cerrar" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="Usuario" Style="{StaticResource Label}" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,12" MaxLength="64" />

                <TextBlock Text="Contraseña" Style="{StaticResource Label}" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,6" MaxLength="128"
                             KeyDown="Password_KeyDown" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Padding="18,10"
                        Click="Cancel_Click" />
                <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource PrimaryButton}"
                        Padding="24,10" Margin="10,0,0,0" Click="Login_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

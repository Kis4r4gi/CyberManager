<Window x:Class="CyberManager.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberManager · Administración" Width="1480" Height="900"
        MinWidth="1080" MinHeight="620" WindowStartupLocation="Manual"
        ResizeMode="CanResize" Background="{StaticResource BgBrush}">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Barra superior ================= -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="C" FontSize="20" FontWeight="Bold" Foreground="#04131B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CyberManager" FontSize="15" FontWeight="Bold" />
                        <TextBlock x:Name="BusinessText" Text="Consola de administración"
                                   Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="12,6" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TASA DEL DÍA" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RateText" Text="1 USD = — Bs" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" Text="Usuario" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock x:Name="RoleText" Text="Administrador" Style="{StaticResource Muted}"
                                   FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Cuerpo ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" MinWidth="170" MaxWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="322" MinWidth="220" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="10,14,10,0">
                        <StackPanel x:Name="NavPanel">
                            <TextBlock Text="OPERACIÓN" Style="{StaticResource Label}" Margin="12,4,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="dashboard" Click="Nav_Click"
                                    ToolTip="Abre el tablero de equipos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Tablero de equipos" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="pos" Click="Nav_Click"
                                    ToolTip="Abre el punto de venta.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Punto de venta" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="cash" Click="Nav_Click"
                                    ToolTip="Abre la caja del turno.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Caja del turno" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="CATÁLOGO" Style="{StaticResource Label}" Margin="12,16,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="products" Click="Nav_Click"
                                    ToolTip="Gestiona productos y tarifas.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Productos y tarifas" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="inventory" Click="Nav_Click"
                                    ToolTip="Consulta el inventario y el kardex.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Inventario y kardex" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="purchases" Click="Nav_Click"
                                    ToolTip="Gestiona compras y proveedores.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Compras y proveedores" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="stations" Click="Nav_Click"
                                    ToolTip="Administra equipos y tokens.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Equipos y tokens" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="PERSONAS" Style="{StaticResource Label}" Margin="12,16,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="customers" Click="Nav_Click"
                                    ToolTip="Gestiona clientes y saldos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Clientes y saldos" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="reservations" Click="Nav_Click"
                                    ToolTip="Gestiona las reservas de equipos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Reservas" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="SISTEMA" Style="{StaticResource Label}" Margin="12,16,0,6" />
                            <Button Style="{StaticResource NavButton}" CommandParameter="wallpapers" Click="Nav_Click"
                                    ToolTip="Gestiona los fondos de pantalla.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Fondos de pantalla" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="promos" Click="Nav_Click"
                                    ToolTip="Gestiona los videos promocionales.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE786;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Videos promocionales" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="reports" Click="Nav_Click"
                                    ToolTip="Consulta los reportes del negocio.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Reportes" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" CommandParameter="settings" Click="Nav_Click"
                                    ToolTip="Abre la configuración del sistema.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" />
                                    <TextBlock Text="Configuración" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="18,10,18,14">
                        <Separator />
                        <TextBlock x:Name="VersionText" Text="CyberManager 1.0" Style="{StaticResource Muted}" FontSize="10" />
                        <TextBlock x:Name="ConnectionText" Text="Conectando..." Style="{StaticResource Muted}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ================= Aviso de nueva versión ================= -->
                <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
                        Margin="18,12,18,0" Padding="14,10" CornerRadius="10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" Text="Nueva versión disponible"
                                       FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock x:Name="UpdateText" Style="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <Button Content="Ver novedades" Style="{StaticResource PrimaryButton}"
                                    Padding="12,7" FontSize="11.5" Click="OpenUpdate_Click"
                                    ToolTip="Abre la página de la nueva versión." />
                            <Button Content="Recordar luego" Style="{StaticResource GhostButton}"
                                    Padding="12,7" FontSize="11.5" Margin="8,0,0,0"
                                    Click="DismissUpdate_Click"
                                    ToolTip="Oculta el aviso durante 2 horas." />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="18" />
            </Grid>

            <!-- ================= Bitácora de terminales ================= -->
            <Border Grid.Column="4" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="14,14,12,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="BITÁCORA" Style="{StaticResource Label}" Margin="0" />
                            <TextBlock Text="Actividad de los terminales" Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Limpiar" Style="{StaticResource GhostButton}"
                                FontSize="11" Padding="10,4" VerticalAlignment="Top"
                                Click="ClearLog_Click" ToolTip="Borrar los eventos de la bitácora" />
                    </DockPanel>

                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LogPanel" Margin="12,0,10,8" />
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                        <Grid>
                            <TextBlock x:Name="LogCountText" Text="0 eventos" Style="{StaticResource Muted}" FontSize="10" />
                            <TextBlock Text="● En vivo" FontSize="10" Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE"
                          ToolTip="Arrastre para ajustar el ancho del menú lateral" />
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE"
                          ToolTip="Arrastre para ajustar el ancho de la bitácora" />
        </Grid>
    </Grid>
    </Border>
</Window>

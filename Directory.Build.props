<Project>
  <Import Project="$(MSBuildThisFileDirectory)version.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>$(CyberManagerVersion)</Version>
    <FileVersion>$(CyberManagerVersion)</FileVersion>
    <InformationalVersion>$(CyberManagerVersion)</InformationalVersion>
    <Company>CyberManager</Company>
    <Product>CyberManager</Product>
    <NeutralLanguage>es</NeutralLanguage>
    <!-- Solo se generan recursos satélite en español e inglés para reducir el tamaño. -->
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
